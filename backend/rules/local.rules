# Snort Local Rules for Network Intrusion Detection System
# Format: action proto src_ip src_port -> dst_ip dst_port (options)

# 1. ICMP Scanning & Ping Sweep
alert icmp any any -> any any (msg:"NIDS DETECTED: ICMP Ping Sweep / Probe"; icmptype:8; sid:1000001; rev:1; classtype:attempted-recon; priority:3;)

# 2. Port Scanning Indicators (Nmap TCP SYN / Xmas / NULL Scan)
alert tcp any any -> any any (msg:"NIDS DETECTED: Nmap TCP SYN Port Scan Attempt"; flags:S; threshold:type threshold, track by_src, count 20, seconds 10; sid:1000002; rev:1; classtype:attempted-recon; priority:2;)
alert tcp any any -> any any (msg:"NIDS DETECTED: Stealth NULL Scan Attempt"; flags:0; sid:1000003; rev:1; classtype:attempted-recon; priority:1;)
alert tcp any any -> any any (msg:"NIDS DETECTED: Stealth Xmas Scan Attempt"; flags:FPU; sid:1000004; rev:1; classtype:attempted-recon; priority:1;)

# 3. Brute Force Login Indicators
alert tcp any any -> any 22 (msg:"NIDS DETECTED: SSH Brute Force Authentication Attempt"; flags:S; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000005; rev:1; classtype:suspicious-login; priority:1;)
alert tcp any any -> any 80 (msg:"NIDS DETECTED: HTTP Login Brute Force Attempt"; content:"POST"; content:"/login"; threshold:type threshold, track by_src, count 10, seconds 30; sid:1000006; rev:1; classtype:suspicious-login; priority:2;)

# 4. Web Application Attacks (SQL Injection / Directory Traversal)
alert tcp any any -> any 80 (msg:"NIDS DETECTED: Web Attack - SQL Injection Attempt (' OR 1=1)"; content:"UNION"; content:"SELECT"; nocase; sid:1000007; rev:1; classtype:web-application-attack; priority:1;)
alert tcp any any -> any 80 (msg:"NIDS DETECTED: Web Attack - Directory Traversal Path Escalation"; content:"../"; sid:1000008; rev:1; classtype:web-application-attack; priority:2;)

# 5. DNS Anomalies & Reconnaissance
alert udp any any -> any 53 (msg:"NIDS DETECTED: DNS Anomaly - Large Payload / Amplification Query"; dsize:>512; sid:1000009; rev:1; classtype:bad-unknown; priority:2;)
alert udp any any -> any 53 (msg:"NIDS DETECTED: DNS Zone Transfer Request Attempt"; content:"|00 00 0fc|"; sid:1000010; rev:1; classtype:attempted-recon; priority:3;)

# 6. Unauthorized Protocol / Port Usage
alert tcp any any -> any 23 (msg:"NIDS DETECTED: Insecure Protocol Telnet Connection Request"; sid:1000011; rev:1; classtype:unauthorized-access; priority:3;)
alert tcp any any -> any 21 (msg:"NIDS DETECTED: Insecure FTP Server Access Attempt"; sid:1000012; rev:1; classtype:unauthorized-access; priority:3;)
